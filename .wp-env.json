{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"phpVersion": "8.1",
	"plugins": [
		"https://downloads.wordpress.org/plugin/polylang.3.9.1.zip"
	],
	"mappings": {
		"wp-content/plugins/toolkit-for-polylang": "."
	},
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": false,
		"SCRIPT_DEBUG": true
	},
	"lifecycleScripts": {
		"afterStart": "bash bin/wp-env-after-start.sh"
	}
}
